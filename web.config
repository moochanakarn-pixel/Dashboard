<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <add value="dashboard.php" />
            </files>
        </defaultDocument>

        <!-- MIME types for PWA -->
        <staticContent>
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/manifest+json" />
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        </staticContent>

        <!-- Block .env from public access -->
        <security>
            <requestFiltering>
                <denyStrings>
                    <add string=".env" />
                </denyStrings>
                <hiddenSegments>
                    <add segment=".env" />
                </hiddenSegments>
            </requestFiltering>
        </security>
    </system.webServer>

    <!-- Block cache/ folder from browser access -->
    <location path="cache">
        <system.webServer>
            <security>
                <requestFiltering>
                    <denyAllRequests>true</denyAllRequests>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
</configuration>
